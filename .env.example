# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file

# Server
PORT=5000

# MongoDB
# Use your MongoDB Atlas connection string
# Example: mongodb+srv://user:pass@cluster0.mongodb.net/employix?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/employix

# JWT
# Generate a random string for production: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Frontend URL (for CORS)
# For local dev: http://localhost:5173
# For production: your Vercel frontend URL (e.g., https://employix.vercel.app)
CLIENT_URL=http://localhost:5173
